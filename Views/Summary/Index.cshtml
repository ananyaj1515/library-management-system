@using LibraryManagementSystem.Dto
@using LibraryManagementSystem.Models
@model Summary
<div class="container justify-content-center" style="min-height: 100vh"> 
    <div class="d-flex gap-5 p-5">
        <div class="card p-4 shadow" style="width: 100%; max-width: 600px">
            <h1 class="text-center mb-4">Counting Statistics</h1>
            <div class="d-flex flex-row justify-content-center align-items-center gap-3">
                <div class="btn btn-lg btn-primary mb-3">@Model.TotalBooks Books</div>
                <div class="btn btn-lg btn-danger mb-3">@Model.TotalAuthors Authors</div>
                <div class="btn btn-lg btn-success mb-3">@Model.TotalGenres Genres</div>
            </div>
        </div>
        <div class="card p-4 shadow" style="width: 100%; max-width: 600px">
            <h1 class="text-center mb-4">Top Rated</h1>
            <div class="d-flex flex-row justify-content-center align-items-center gap-3">
                <div class="btn btn-lg btn-primary mb-3">Top Rated Author: @Model.TopRatedAuthor</div>
                <div class="btn btn-lg btn-success mb-3">Top Rated Book: @Model.TopRatedBook</div>
            </div>
        </div>
    </div>
    <form class="card p-4 shadow flex-d" style="width: 100%; max-width: 600px align-items-center justify-items-center" asp-action="Index" method="get">
        <h1 class="text-center mb-4">Search Books by Author</h1>
        <div class="form-group mb-3">
            <label for="authorId" class="form-label">Author</label>
            <select class="form-control" id="authorId" name="authorId">
                <option value="">Select Author</option>
                @foreach (var author in @Model.Authors)
                {
                    <option value="@author.Id">@author.Name</option>
                }
            </select>
        </div>
         <input type="submit" class="btn btn-primary w-100" value="Submit"/>
    </form>
    <table class="table table-bordered table-hover p-4">
        <thead class="table-dark">
             <tr>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Publication Date</th>
                    <th>Rating</th> 
                </tr>
        </thead>
        <tbody>
                @{
                    if(Model != null && Model.BookForAuthor.Count > 0)
                    {
                        foreach (BookDto book in Model.BookForAuthor)
                        {
                            <tr>
                                <td><b>@book.Title</b></td>
                                <td>@book.Genre</td>
                                <td>@book.PublicationDate</td>
                                <td>@book.Rating</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No books found.</td>
                        </tr>
                    }
                }                
            </tbody>
    </table>
</div>