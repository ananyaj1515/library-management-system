@using LibraryManagementSystem.Dto
@model UserDto
<div>@ViewBag.ErrorMessage</div>
<div>@ViewBag.SuccessMessage</div>
<form class="container d-flex justify-content-center align-items-center" style="min-height: 100vh" asp-action="LoginUser">
    <div class="card p-4 shadow" style="width: 100%; max-width: 400px">
        
        <h3 class="text-center mb-4">Login</h3>

        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email" class="form-control" id="email" name="email" asp-for="Email" placeholder="Enter email" required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" placeholder="Password" name="password" asp-for="Password"required>
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </div>
</form>
Don't have an account? <a asp-controller="Auth" asp-action="Register"> Register Here Instead</a>