@using LibraryManagementSystem.Dto
@model List<AuthorDto>
<div style="color: red;">@ViewBag.ErrorMessage</div>
<div style="color: green;">@ViewBag.SuccessMessage</div>
<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        
        <h3 class="m-0">Author Dashboard</h3>
        <a class="btn btn-success" asp-action="RediectToAuthorForm">+ Add Author</a>
    </div>

    <div class="card shadow p-3">
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Rating</th>
                    <th>Bio</th>
                    <th>Email</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if(Model != null && Model.Count > 0)
                    {
                        foreach (AuthorDto author in Model)
                        {
                            <tr>
                                <td>@author.Name</td>
                                <td>@author.Rating</td>
                                <td>@author.Bio</td>
                                <td>@author.Email</td>
                                <td>
                                    <a class="btn btn-sm btn-primary" asp-action="UpdateAuthor" asp-route-id="@author.Id">Edit </a>
                                    <a class="btn btn-sm btn-danger" asp-action="DeleteAuthor" asp-route-id="@author.Id">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No authors found.</td>
                        </tr>
                    }
                }                
            </tbody>
        </table>
    </div>

</div>